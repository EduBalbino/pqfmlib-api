+constexpr std::size_t kScalarNodesPerLaunch = 32;
+
+// By-value parameters keep the node descriptors off the allocator and transfer paths.
+struct ScalarHistogramBatch {
+  DeviceHistogramBuilder::ScalarHistogramNode nodes[kScalarNodesPerLaunch];
+  std::uint32_t block_offsets[kScalarNodesPerLaunch + 1];
+  std::uint32_t size;
+};
+static_assert(sizeof(ScalarHistogramBatch) < 2048);
+
+template <typename Policy, typename Accessor>
+__global__ __launch_bounds__(StHistBound::kBlockThreads, StHistBound::kMinBlocks)
+    void BatchedStHistKernel(Accessor const matrix, FeatureGroupsAccessor const feature_groups,
+                             common::Span<GradientPairInt64 const> gpair,
+                             const __grid_constant__ ScalarHistogramBatch batch) {
+  auto const* offsets = batch.block_offsets;
+  auto const node_idx = dh::SegmentId(offsets, offsets + batch.size + 1, blockIdx.x);
+  auto const blocks = offsets[node_idx + 1] - offsets[node_idx];
+  bst_idx_t const offset = (blockIdx.x - offsets[node_idx]) * Policy::kTileSize;
+  auto const stride = Policy::kTileSize * blocks;
+  auto const& node = batch.nodes[node_idx];
+  extern __align__(cuda::std::alignment_of_v<GradientPairInt64>) __shared__ char shmem[];
+  HistKernelOneNodeTarget<Policy>(matrix, feature_groups[blockIdx.y], node.rows, gpair.data(),
+                                  reinterpret_cast<GradientPairInt64*>(shmem),
+                                  node.histogram.data(), offset, stride);
+}
