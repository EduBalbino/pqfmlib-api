+  template <bool kDense, bool kCompressed, typename Accessor>
+  void DispatchHistShmem(Context const* ctx, Accessor const& matrix,
+                         FeatureGroupsAccessor const& feature_groups,
+                         common::Span<GradientPairInt64 const> gpair,
+                         common::Span<DeviceHistogramBuilder::ScalarHistogramNode const> nodes) {
+    auto const shmem_bytes = feature_groups.ShmemSize();
+    auto launch = [&](auto policy, auto kernel, std::size_t shared) {
+      using Policy = common::GetValueT<decltype(policy)>;
+      this->SetCfg(policy, shared, kernel);
+      auto const& cfg = this->cfg.at(reinterpret_cast<void*>(kernel));
+      auto const cap = static_cast<std::size_t>(cfg.n_blocks_per_mp) * this->n_mps;
+      CHECK_GT(cap, 0);
+      auto const columns = common::DivRoundUp(matrix.row_stride, feature_groups.NumGroups());
+      ScalarHistogramBatch batch{};
+      auto flush = [&] {
+        if (batch.size == 0) {
+          return;
+        }
+        dim3 grid(batch.block_offsets[batch.size], feature_groups.NumGroups());
+        dh::LaunchKernel(grid, Policy::kBlockThreads, shared, ctx->CUDACtx()->Stream())(
+            kernel, matrix, feature_groups, gpair, batch);
+        dh::safe_cuda(cudaPeekAtLastError());
+        batch.size = 0;
+      };
+      for (auto const& node : nodes) {
+        if (node.rows.empty()) {
+          continue;
+        }
+        auto const items = static_cast<std::size_t>(node.rows.size()) * columns;
+        auto const blocks = std::min(cap, common::DivRoundUp(items, Policy::kTileSize));
+        batch.nodes[batch.size] = node;
+        batch.block_offsets[batch.size + 1] = batch.block_offsets[batch.size] + blocks;
+        if (++batch.size == kScalarNodesPerLaunch) {
+          flush();
+        }
+      }
+      flush();
+    };
+    if (!this->force_global && shmem_bytes <= this->max_shared_bytes) {
+      using Policy = HistPolicy<StHistBound, kItemsPerThread, kDense, kCompressed, true>;
+      launch(Policy{}, BatchedStHistKernel<Policy, Accessor>, shmem_bytes);
+    } else {
+      using Policy = HistPolicy<StHistBound, kItemsPerThread, kDense, kCompressed, false>;
+      launch(Policy{}, BatchedStHistKernel<Policy, Accessor>, 0);
+    }
+  }
