+void DeviceHistogramBuilder::BuildScalarHistograms(
+    Context const* ctx, EllpackAccessor const& matrix, FeatureGroupsAccessor const& feature_groups,
+    common::Span<GradientPairInt64 const> gpair, common::Span<ScalarHistogramNode const> nodes) {
+  this->monitor_.Start(__func__);
+  std::visit(
+      [&](auto const& acc) {
+        this->p_impl_->BuildHistogram(ctx, acc, feature_groups, gpair, nodes);
+      },
+      matrix);
+  this->monitor_.Stop(__func__);
+}
